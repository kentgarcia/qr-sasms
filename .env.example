# ── Database ────────────────────────────────────────────────
# Matches the docker-compose.yml Postgres service below.
DATABASE_URL="postgresql://stars:stars@localhost:5432/stars?schema=public"

# ── Auth ────────────────────────────────────────────────────
# Any long random string. Used to sign the httpOnly session cookie (JWT).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-this-to-a-long-random-string"

# ── Outgoing email (SMTP via Nodemailer) ───────────────────────
# Leave these blank to run in SIMULATED mode: emails are recorded in the
# in-app "Email Outbox" (admin dashboard) and as Notifications, but no
# real email is sent. Fill them in to send real email.
#
# Example for Gmail: create a 16-character "App Password" at
# https://myaccount.google.com/apppasswords (requires 2FA enabled) and use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="STARS <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STARS <no-reply@pup-sanpedro.edu.ph>"

# Optional: enables automated Nodemailer reminders through an external scheduler.
# Schedule POST /api/cron/reminders hourly using Authorization: Bearer <this value>.
CRON_SECRET=

# ── Super Admin bootstrap (`npm run bootstrap:admin`) ─────────
# Used ONLY to create the first SUPER_ADMIN account when none exists
# (e.g. fresh production database). The demo seed already provides
# superadmin@pup.edu.ph locally, so these are optional for development.
# BOOTSTRAP_SUPER_ADMIN_EMAIL="sso-admin@pup.edu.ph"
# BOOTSTRAP_SUPER_ADMIN_PASSWORD="use-a-password-of-at-least-10-characters"
# BOOTSTRAP_SUPER_ADMIN_NAME="SSO Admin"

# ── File uploads ────────────────────────────────────────────
# Absolute or project-relative directory where uploaded files
# (OR receipts, event documents, complaint attachments, downloadable
# forms) are stored on disk. Served publicly under /uploads/*.
UPLOAD_DIR="./public/uploads"

# ── AI assistant semantic matching (Phase 1) ─────────────────
# Local Ollama instance serving the embedding model. Leave unset or
# unreachable to run the chatbot in keyword mode (degraded, still fully
# functional). No paid API is used.
# OLLAMA_BASE_URL="http://localhost:11434"
# ASSISTANT_EMBED_MODEL="all-minilm:l6-v2"
