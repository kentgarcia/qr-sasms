





generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  SCANNER
}

model MasterlistEntry {
  id         String   @id @default(uuid())
  sn         String   @unique
  name       String   @default("")
  email      String   @default("")
  course     String   @default("")
  year       String   @default("") 
  schoolYear String   @default("") 
  createdAt  DateTime @default(now())
}






model MasterlistGroup {
  id         String   @id @default(uuid())
  schoolYear String
  course     String
  year       String
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolYear, course, year])
}

model QueueEntry {
  id        String   @id @default(uuid())
  code      String   @unique 
  studentId String
  name      String
  time      String
  dateLabel String
  served    Boolean  @default(false)
  // Appointment-based system (see docs/appointment-system-spec.md).
  // `served` is kept in sync with `status` for backward compatibility
  // with existing clients: SERVED <=> served=true.
  // Service keys: GENERAL (legacy), ID_NEW, ID_LOST, EVENT, AUTH, EXCUSE, PSYCH.
  // Status values: BOOKED, RESCHEDULED, CHECKED_IN, SERVED, CANCELLED, NO_SHOW
  // (plus legacy PENDING, treated as BOOKED).
  serviceType    String    @default("GENERAL")
  serviceRefId   String?
  organizationId String?
  notes          String    @default("")
  status         String    @default("BOOKED")
  dateISO        String    @default("")
  slotStartAt    DateTime?
  slotEndAt      DateTime?
  cancelReason   String?
  bookedBy       String?
  rescheduleCount Int     @default(0)
  purpose        String  @default("")
  copies         Int     @default(1)
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([dateLabel, time])
  // NOTE: one-active-appointment-per-student-per-date is enforced by the
  // partial unique index in migration 20260926000000_appointment_services
  // (active statuses only, so cancelled/no-show history never blocks rebooking).
  @@index([status])
  @@index([serviceType, status])
  @@index([dateLabel, time, serviceType, status])
}

model ServiceSlotConfig {
  id          String   @id @default(uuid())
  service     String   @unique
  durationMin Int      @default(10)
  capacity    Int      @default(1)
  weekdays    Int[]    @default([1, 2, 3, 4, 5])
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model SlotBlock {
  id        String   @id @default(uuid())
  dateLabel String
  time      String?
  service   String?
  reason    String   @default("")
  createdBy String   @default("")
  createdAt DateTime @default(now())

  @@index([dateLabel])
}

model AuditLog {
  id        String   @id @default(uuid())
  type      String 
  msg       String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String?
  name      String
  ref       String
  doc       String
  status    String
  mode      String 
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  target    String 
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target])
}

model Referral {
  id        String   @id
  sn        String
  name      String
  category  String
  details   String
  status    String   @default("Pending")
  remarks   String   @default("")
  history   Json     @default("[]")
  // Optional appointment chosen as part of the request (spec §4).
  appointmentCode String?
  appointmentDate String   @default("")
  appointmentTime String   @default("")
  createdAt DateTime @default(now())

  @@index([sn])
}

model IdApplication {
  id            String   @id
  sn            String
  name          String
  type          String
  reason        String
  orName        String
  orUrl         String
  affidavitName String?
  affidavitUrl  String?
  status        String   @default("Pending")
  remarks       String   @default("")
  history       Json     @default("[]")
  // Pickup leg (spec §2): admin schedules pickup when the ID is ready,
  // student is notified, pickup completes the request.
  pickupDate    String   @default("")
  pickupTime    String   @default("")
  pickupNote    String   @default("")
  pickedUpAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([sn])
  @@index([status])
}

// Request-based + General Visit services (spec §§2,5).
// Authentication, Excuse Slip and General Visit requests live here.
// Auth/Excuse: request → review → processing → ready → pickup schedule → pickup → completed.
// General Visit: request (+ schedule selected at submit) → review → confirmed → check-in → in progress → completed.
model ServiceRequest {
  id              String   @id
  sn              String
  name            String
  service         String
  subject         String   @default("")
  details         String   @default("")
  copies          Int      @default(1)
  docName         String   @default("")
  docUrl          String?
  status          String   @default("Pending Review")
  remarks         String   @default("")
  history         Json     @default("[]")
  // General Visit: schedule chosen as part of the request (spec §5).
  appointmentCode String?
  dateLabel       String   @default("")
  time            String   @default("")
  slotStartAt     DateTime?
  // Pickup leg for Authentication / Excuse Slip (spec §2).
  pickupDate      String   @default("")
  pickupTime      String   @default("")
  pickupNote      String   @default("")
  pickedUpAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sn])
  @@index([service, status])
}

model Bulletin {
  id        String    @id
  title     String
  category  String
  body      String
  featured  Boolean   @default(false)
  status    String    @default("Published") 
  publishAt DateTime?
  updatedTs DateTime?
  createdAt DateTime  @default(now())
}

model Ticket {
  id        String   @id
  sn        String
  name      String
  category  String
  subject   String
  status    String   @default("Open") 
  msgs      Json     @default("[]")
  createdAt DateTime @default(now())
  // Phase 0 (AI assistant spec): optional link to the chat session that
  // produced this ticket. Set when a student escalates from the chatbot.
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([sn])
}

// Phase 0 (AI assistant + ticket escalation spec, docs/ai-assistant-ticket-escalation-spec.md).
// Server-side chat persistence. v0 stores keyword-match answers; embeddings arrive in Phase 1.
model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  studentId String
  subject   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]
  tickets   Ticket[]
  feedbacks ChatFeedback[]

  @@index([studentId])
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  text       String
  faqId      String?
  confidence String?
  // Phase 2: provenance of SIS-data answers (e.g. "ticket:TKT-1",
  // "appointment:APT-007"). Null for KB answers. Used by analytics.
  dataSource String?
  createdAt  DateTime @default(now())
  feedback   ChatFeedback?

  @@index([sessionId])
}

// Improvement spec F-2: per-answer 👍/👎. One row per assistant message;
// facts stay on ChatMessage (immutable), votes live here for analytics.
model ChatFeedback {
  id        String      @id @default(uuid())
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  value     Int
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([studentId])
}

model Faq {
  id        String   @id
  cat       String
  q         String
  a         String
  createdAt DateTime @default(now())
  embedding FaqEmbedding?
}

model FaqCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Phase 1 (AI assistant spec): 384-dim all-MiniLM-L6-v2 embedding per FAQ.
// Written via raw SQL (see migration); Prisma sees an opaque column.
model FaqEmbedding {
  faqId     String   @id
  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(384)")?
  updatedAt DateTime @updatedAt
}

model EventRequest {
  id           String   @id
  sn           String
  name         String
  title        String
  org          String
  organizationId String?
  adviser      String
  date         String
  time         String
  venue        String
  participants String
  budget       String   @default("")
  desc         String
  type         String
  docName      String   @default("")
  docUrl       String?
  status       String   @default("Pending")
  history      Json     @default("[]")
  // Optional appointment chosen as part of the request (spec §§3-5).
  appointmentCode String?
  appointmentDate String   @default("")
  appointmentTime String   @default("")
  createdAt    DateTime @default(now())

  @@index([sn])
  @@index([organizationId, date])
}

model UploadedFile {
  id           String   @id @default(uuid())
  storedName   String   @unique
  originalName String
  mimeType     String
  bytes        Bytes
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([uploadedBy])
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  adviserName String
  schoolYear  String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  representatives OrganizationRepresentative[]
}

model OrganizationRepresentative {
  id             String   @id @default(uuid())
  organizationId String
  studentId      String
  assignedBy     String
  active         Boolean  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, studentId])
  @@index([studentId, active])
}

model Complaint {
  id              String   @id
  sn              String
  name            String
  category        String
  details         String
  attName         String   @default("")
  attUrl          String?
  status          String   @default("Submitted")
  note            String   @default("")
  confidentiality String   @default("Standard") 
  assignedTo      String?
  staffNotes      String   @default("")
  createdAt       DateTime @default(now())

  @@index([sn])
}

model DownloadableForm {
  id        String   @id
  title     String
  cat       String
  fileName  String
  url       String
  createdAt DateTime @default(now())
}

model Memo {
  id            String   @id
  subject       String
  audienceLabel String
  recipients    Int
  by            String
  mode          String
  createdAt     DateTime @default(now())
}

model User {
  id               String    @id @default(uuid())
  studentId        String?   @unique 
  email            String    @unique
  passwordHash     String
  role             Role
  name             String
  course           String?
  year             String?
  approved         Boolean   @default(true) 
  active           Boolean   @default(true) 
  resetToken       String?   
  resetTokenExpiry DateTime? 
  createdAt        DateTime  @default(now())

  @@index([studentId])
  @@index([role])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ProfileChange {
  id        String   @id @default(uuid())
  userId    String
  studentId String
  name      String
  email     String
  course    String?
  year      String?
  status    String   @default("Pending") 
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model ServiceFeedback {
  id        String   @id @default(uuid())
  requestId String   @unique
  studentId String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([studentId])
}

model ReminderLog {
  id          String   @id @default(uuid())
  reminderKey String   @unique
  createdAt   DateTime @default(now())
}
