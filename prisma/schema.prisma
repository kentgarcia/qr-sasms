





generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  SCANNER
}

model MasterlistEntry {
  id         String   @id @default(uuid())
  sn         String   @unique
  name       String   @default("")
  email      String   @default("")
  course     String   @default("")
  year       String   @default("") 
  schoolYear String   @default("") 
  createdAt  DateTime @default(now())
}






model MasterlistGroup {
  id         String   @id @default(uuid())
  schoolYear String
  course     String
  year       String
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolYear, course, year])
}

model DocumentRequest {
  id           String   @id 
  studentId    String
  studentName  String
  doc          String
  docKey       String
  purpose      String
  copies       Int      @default(1)
  notes        String   @default("")
  status       String   @default("Pending") 
  rejectReason String?
  rejectedAt   String?
  rejectedBy   String?
  claimRef     String?  @unique 
  
  
  claimToken       String?   @unique
  claimTokenExpiry DateTime?
  claimedAt    String?
  claimedBy    String?
  reuploadName String?
  reuploadUrl  String?
  signature    String?
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([status])
}

model QueueEntry {
  id        String   @id @default(uuid())
  code      String   @unique 
  studentId String
  name      String
  time      String
  dateLabel String
  served    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([dateLabel, time])
  @@unique([studentId, dateLabel])
}

model AuditLog {
  id        String   @id @default(uuid())
  type      String 
  msg       String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String?
  name      String
  ref       String
  doc       String
  status    String
  mode      String 
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  target    String 
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target])
}

model Referral {
  id        String   @id
  sn        String
  name      String
  category  String
  details   String
  status    String   @default("Pending")
  remarks   String   @default("")
  history   Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([sn])
}

model IdApplication {
  id            String   @id
  sn            String
  name          String
  type          String
  reason        String
  orName        String
  orUrl         String
  affidavitName String?
  affidavitUrl  String?
  status        String   @default("Pending")
  remarks       String   @default("")
  createdAt     DateTime @default(now())

  @@index([sn])
}

model Bulletin {
  id        String    @id
  title     String
  category  String
  body      String
  featured  Boolean   @default(false)
  status    String    @default("Published") 
  publishAt DateTime?
  updatedTs DateTime?
  createdAt DateTime  @default(now())
}

model Ticket {
  id        String   @id
  sn        String
  name      String
  category  String
  subject   String
  status    String   @default("Open") 
  msgs      Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([sn])
}

model Faq {
  id        String   @id
  cat       String
  q         String
  a         String
  createdAt DateTime @default(now())
}

model FaqCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model EventRequest {
  id           String   @id
  sn           String
  name         String
  title        String
  org          String
  organizationId String?
  adviser      String
  date         String
  time         String
  venue        String
  participants String
  budget       String   @default("")
  desc         String
  type         String
  docName      String   @default("")
  docUrl       String?
  status       String   @default("Pending")
  history      Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([sn])
  @@index([organizationId, date])
}

model UploadedFile {
  id           String   @id @default(uuid())
  storedName   String   @unique
  originalName String
  mimeType     String
  bytes        Bytes
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([uploadedBy])
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  adviserName String
  schoolYear  String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  representatives OrganizationRepresentative[]
}

model OrganizationRepresentative {
  id             String   @id @default(uuid())
  organizationId String
  studentId      String
  assignedBy     String
  active         Boolean  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, studentId])
  @@index([studentId, active])
}

model Complaint {
  id              String   @id
  sn              String
  name            String
  category        String
  details         String
  attName         String   @default("")
  attUrl          String?
  status          String   @default("Submitted")
  note            String   @default("")
  confidentiality String   @default("Standard") 
  assignedTo      String?
  staffNotes      String   @default("")
  createdAt       DateTime @default(now())

  @@index([sn])
}

model DownloadableForm {
  id        String   @id
  title     String
  cat       String
  fileName  String
  url       String
  createdAt DateTime @default(now())
}

model Memo {
  id            String   @id
  subject       String
  audienceLabel String
  recipients    Int
  by            String
  mode          String
  createdAt     DateTime @default(now())
}

model User {
  id               String    @id @default(uuid())
  studentId        String?   @unique 
  email            String    @unique
  passwordHash     String
  role             Role
  name             String
  course           String?
  year             String?
  approved         Boolean   @default(true) 
  active           Boolean   @default(true) 
  resetToken       String?   
  resetTokenExpiry DateTime? 
  createdAt        DateTime  @default(now())

  @@index([studentId])
  @@index([role])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ProfileChange {
  id        String   @id @default(uuid())
  userId    String
  studentId String
  name      String
  email     String
  course    String?
  year      String?
  status    String   @default("Pending") 
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model ServiceFeedback {
  id        String   @id @default(uuid())
  requestId String   @unique
  studentId String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([studentId])
}

model ReminderLog {
  id          String   @id @default(uuid())
  reminderKey String   @unique
  createdAt   DateTime @default(now())
}
